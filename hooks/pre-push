#!/usr/bin/env bash
# Pre-push guard for this PUBLIC dotfiles repo.
# Scans commits being pushed for secrets and pasted company-confidential
# content using gitleaks (+ repo rules in .gitleaks.toml).
#
# Install once:  just install-hooks   (sets core.hooksPath=hooks)
# Bypass once:   git push --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
config="$repo_root/.gitleaks.toml"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not found — install it (brew install gitleaks) or bypass with 'git push --no-verify'." >&2
  exit 1
fi

# stdin: <local ref> <local sha> <remote ref> <remote sha>  (per line)
zero="0000000000000000000000000000000000000000"
fail=0

scan_range() {
  local range="$1"
  gitleaks detect \
    --source "$repo_root" \
    --config "$config" \
    --log-opts="$range" \
    --redact --no-banner 2>&1 || return 1
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue           # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"                              # new branch: scan all reachable
  else
    range="$remote_sha..$local_sha"                 # only the new commits
  fi
  if ! scan_range "$range"; then
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: leak/confidential check FAILED — push aborted." >&2
  echo "  Review the findings above. False positive? Adjust .gitleaks.toml allowlist." >&2
  echo "  Intentional? Bypass with: git push --no-verify" >&2
  exit 1
fi

echo "pre-push: gitleaks clean."
