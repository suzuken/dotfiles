# Machine-local env not tracked in dotfiles (e.g. work-specific tools).
# Useful for non-interactive login shells (GUI apps like Claude Desktop),
# which read .zprofile but not .zshrc.
[ -f "$HOME/.zprofile.local" ] && source "$HOME/.zprofile.local"
